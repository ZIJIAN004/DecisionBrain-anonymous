+    command = build_command(
+        ["python", "run.py"],
+        repo=repo,
+        python_env=python_env,
+        output_dir=output,
+        task_data=task_data,
+        problem=problem,
+        solution_schema=schema,
+        instance=instance,
+        license_file=license_file,
+        gurobi_home=gurobi_home,
