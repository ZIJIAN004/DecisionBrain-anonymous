# OpenAI-compatible Chat Completions endpoint URL.
LLM_MODEL_URL=https://api.deepseek.com/chat/completions
# Bearer credential sent to the LLM endpoint; never commit a real value.
LLM_API_KEY=replace-with-your-api-key
# Model identifier accepted by the configured LLM endpoint.
LLM_CHAT_MODEL=deepseek-v4-pro
# OPT_ variables tune optimization-agent runtime behavior.
# Provider-specific reasoning effort; use an empty value when unsupported.
OPT_REASONING_EFFORT="max"
# Timeout in seconds for one LLM HTTP request.
OPT_LLM_TIMEOUT=300
# LLM sampling temperature in the inclusive range 0 to 2.
OPT_LLM_TEMPERATURE=0.2
# Total LLM network attempts, including the first request.
OPT_LLM_MAX_ATTEMPTS=4
# Initial retry delay in seconds; later delays use exponential backoff.
OPT_LLM_RETRY_BASE_DELAY_SECONDS=2

# Maximum solver and workspace shell runtime in seconds.
SOLVER_TIMEOUT=300
# Total logical-CPU budget shared across concurrent benchmark jobs.
SOLVER_CPU_BUDGET=24
# Absolute directory containing system and developer prompt files.
OPT_PROMPTS_DIR=/absolute/path/to/DecisionBrain/prompts
# Absolute directory containing validated algorithm manifest YAML files.
OPT_ALGORITHM_MANIFESTS_DIR=/absolute/path/to/DecisionBrain/algorithms/manifests
# Absolute directory containing validated algorithm composition recipes.
# Maximum characters returned by a workspace tool call.
OPT_WORKSPACE_MAX_OUTPUT_CHARS=12000
# Hard cap on entries returned by the workspace list_files tool.
OPT_WORKSPACE_MAX_LIST_ENTRIES=1000
# Entry count used when list_files does not request an explicit limit.
OPT_WORKSPACE_DEFAULT_LIST_ENTRIES=200
# Maximum file size in bytes accepted by the workspace read_file tool.
OPT_WORKSPACE_MAX_READ_BYTES=1000000
# Poll interval in seconds while an Agent waits for clarification input.
OPT_AGENT_RESUME_POLL_INTERVAL_SECONDS=0.1
# API bind address.
HOST=0.0.0.0
# API listen port.
PORT=8008

# Directory where Run records, events, workspaces, and artifacts are stored.
DBN_RUNS_DIR=/absolute/path/to/DecisionBrain/runs
# Maximum single input file size in bytes copied into a Run snapshot.
DBN_SNAPSHOT_MAX_FILE_SIZE_BYTES=52428800
# Maximum number of active Runs held by one API process.
DBN_MAX_ACTIVE_RUNS=5
# Enable detailed diagnostic and streamed reasoning events.
DBN_DEBUG=false
# Default web-interface language: en or zh. Users can override it in the browser.
DBN_UI_LANGUAGE=en
# Timeout in seconds for each external command checked by dbn doctor.
DBN_DOCTOR_COMMAND_TIMEOUT_SECONDS=5

# Optional Gurobi license file path read directly by gurobipy.
GRB_LICENSE_FILE=/absolute/path/to/gurobi.lic
